# @react-three/fiber is pinned to 9.5.0, the version the original site ships (its R3F renderer registers as 9.5.0).
# That release declares a peer range of react / react-dom ">=19 <19.3"; this project's react is 19.3.x (and Next.js
# renders the app with its own vendored React 19.3 canary, as the original does). Without this flag npm refuses the
# install (ERESOLVE). See docs/evidence/verify/chain/SUMMARY.md.
legacy-peer-deps=true
